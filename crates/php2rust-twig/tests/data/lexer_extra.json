{
 "doc-block": "{## A doc ##}\n{% block foo %}{% endblock %}",
 "doc-hash-close": "{## A doc #}x",
 "doc-empty": "{##}a",
 "doc-trim": "  {##- doc -##}  b",
 "doc-line-trim": "  {##~ doc ~##}  \n b",
 "doc-multi": "{## one ##}\n{## two\r\n lines ##}\n\n{{ x }}",
 "doc-inline": "{% set\n  ## the value\n  x = 1 %}",
 "doc-blank-text": "{## d ##}   {{ y }}",
 "doc-cleared-by-verbatim": "{## d ##}{% verbatim %}a{% endverbatim %}{{ z }}",
 "doc-cleared-by-line": "{## d ##}{% line 5 %}{{ z }}",
 "comment-trim": "a  {#- c -#}  b",
 "comment-line-trim": "a  {#~ c ~#}  \n  b",
 "comment-newline": "a{# c #}\nb",
 "comment-crlf": "a{# c #}\r\nb",
 "comment-unclosed": "a{# c",
 "verbatim-trim": "{% verbatim -%}  x  {%- endverbatim -%}  y",
 "verbatim-line-trim": "{%~ verbatim ~%}  x \n {%~ endverbatim ~%}  \ny",
 "verbatim-plain": "{% verbatim %}\n{{ a }}\n{% endverbatim %}\nz",
 "verbatim-unclosed": "{% verbatim %}abc",
 "verbatim-no-space": "{%verbatim%}x{%endverbatim%}",
 "line-big": "{% line 99999999999999999999 %}{{ a }}",
 "line-bad": "{% line x %}",
 "var-trim": "a  {{- x -}}  \n  b",
 "var-line-trim": "a \n {{~ x ~}} \n b",
 "block-newline": "{% if a %}\nx{% endif %}\r\ny{% endif %}\rz",
 "block-trim": "x \n {%- if a -%} \n y",
 "numbers": "{{ 1_000 + 1.5e3 + 2E-2 + 0.5 + 1_2.3_4e+5_6 + 9223372036854775807 + 9223372036854775808 + 1__2 + 1. + 3e }}",
 "range": "{{ 1..2 }}{{ a..b }}",
 "nullsafe": "{{ a?.b }}{{ a ?: b }}{{ a ? : b }}{{ a ?? b }}",
 "word-ops": "{{ a not in b }}{{ a is not b }}{{ a starts  with b }}{{ a ends\nwith b }}{{ a has some b }}{{ a has every b }}{{ not a }}{{ a matches b }}{{ a b-and b }}",
 "word-op-followers": "{{ a and(b) }}{{ a or[b] }}{{ a in{b} }}{{ a and)}}{{ notx }}{{ a.not }}{{ a|not }}{{ a. not }}{{ a | not }}{{ a .not }}",
 "symbol-ops": "{{ a === b !== c <=> d // e ** f % g ~ h => i ... j }}",
 "assign": "{% set a = 1 %}{% set a, b = 1, 2 %}",
 "arrow": "{{ a|map((x, y) => x ~ y) }}",
 "punct": "{{ {a: [1, 2], 'b': (3)} }}",
 "names-utf8": "{{ café.naïve }}",
 "strings": "{{ 'a\\nb' ~ \"c\\td\" ~ 'e\\\\f' ~ \"g\\#h\" ~ 'i\\x41\\x4' ~ '\\0\\01\\012\\0123' ~ 'trailing\\\\' }}",
 "string-deprecations": "{{ 'a\\qb' ~ \"c\\'d\" ~ '\\e' }}",
 "dq-interp": "{{ \"a#{b}c#{ d ~ \"e#{f}\" }g\" }}",
 "dq-hash": "{{ \"a#b#\" }}{{ \"#\" }}",
 "dq-newline": "{{ \"a\r\nb\" }}",
 "sq-newline": "{{ 'a\r\nb' }}",
 "interp-spaces": "{{ \"#{   a   }\" }}",
 "interp-braces": "{{ \"#{ {a: 1}|length }\" }}",
 "unclosed-string": "{{ 'abc }}",
 "unclosed-dq": "{{ \"abc }}",
 "unclosed-interp": "{{ \"#{ a\" }}",
 "unexpected-char": "{{ a @ b }}",
 "unexpected-utf8": "{{ a € b }}",
 "dq-backslash-end": "{{ \"abc\\",
 "unclosed-paren-multiline": "{{ (\n1\n+ 2 }}",
 "unclosed-var": "{{ a",
 "unclosed-block-ws": "{% a   ",
 "closing-mismatch": "{{ [1) }}",
 "tags-in-text": "a { b } {x} %} }} #} c",
 "nested-tag-start": "{{{ a }}}",
 "inline-comment-cr": "{{ a # c\r b }}",
 "inline-doc": "{{ a ## doc\n }}",
 "crlf-lines": "a\r\nb\r\n{{ c\r\n}}\r\n{% d\r\n%}\r\n",
 "cr-lines": "a\rb\r{{ c\r}}\r",
 "empty": "",
 "only-text": "hello\n",
 "var-no-space": "{{a}}{{-a-}}{{~a~}}",
 "minus-number": "{{ -1 - -2 }}",
 "dot-number": "{{ a.0.1 }}{{ .5 }}",
 "question": "{{ a ? b : c }}{{ a?b:c }}",
 "pipe-spacing": "{{ a |upper| lower }}",
 "keyword-at-end": "{{ a and",
 "op-then-eof": "{{ a or}}",
 "block-ws-before-close": "{%  if  a  %}{%  endif  %}",
 "brackets-in-block": "{% if (a %}",
 "multiple-trims": "{%- a -%}{{- b -}}{#- c -#}"
}